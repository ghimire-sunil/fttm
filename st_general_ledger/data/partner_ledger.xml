<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record model="ir.model.data" id="partner_ledger_report_data">
            <field name="name">partner_ledger_report</field>
            <field name="model">account.report</field>
            <field name="res_id" ref="account_reports.partner_ledger_report"/>
        </record>

        <record id="account_reports.partner_ledger_report_balance" model="account.report.column">
            <field name="name"> Closing Balance</field>
            <field name="expression_label">balance</field>
        </record>

        <record id="opening_balance_column" model="account.report.column">
            <field name="report_id" ref="account_reports.partner_ledger_report"/>
            <field name="name">Opening Balance</field>
            <field name="sequence">60</field>
            <field name="figure_type">monetary</field>
            <field name="blank_if_zero">False</field>
            <field name="sortable">True</field>
            <field name="expression_label">opening_balance</field>
        </record>

    </data>
</odoo>
