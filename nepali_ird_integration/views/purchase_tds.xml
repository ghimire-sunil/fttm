<odoo>
    <record id="view_purchase_tds_list" model="ir.ui.view">
        <field name="name">purchase.tds.list</field>
        <field name="model">account.move</field>
        <field name="arch" type="xml">
            <list create = "0">
                <header>
                    <button name="%(nepali_ird_integration.action_open_ng_sale_wizard_form)d" string="Download" type="action" class="btn-primary" display = "always" context="{'default_type': 'tds_report'}"/>
                </header>
                <field name="nepali_date" string = "Date(B.S.)" />
                <field name="invoice_date" string = "Date(A.D.)" />
                <field name="name" string="Bill No."/>
                <field name="invoice_partner_display_name" string="Vendor's Name"/>
                <field name="buyer_pan" string = "Vendor's PAN No."/>
                <field name="amount_untaxed" string = "Total Purchase" sum = "Total Amount"/>
                <field name="nontaxable_amount" string = "Non Taxable Purchase" sum = "Non Taxable Purchase"/>
                <field name="export_sales" string = "Import Sales" sum = "Import Sales"/>
                <field name="amount_discount" sum = "Amount Discount"/>
                <field name="taxable_amount" string ="Taxable Amount" sum="Taxable Amount"/>
                <field name="tds_amount" string = "TDS Amount" sum = "TDS Amount"/>
                <field name="currency_id" column_invisible = "1"/>
            </list>
        </field>
    </record>

    <record id="action_purchase_tds" model="ir.actions.act_window">
        <field name="name">TDS Report</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,form</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_purchase_tds_list')})]"/>
        <field name="domain">[('move_type', '=', 'in_invoice'), ('is_tds_applicable','=',True)]</field>
    </record>
    <menuitem name="TDS Report" id="menu_purchase_tds" parent="ird_purchase_report_menu" action="action_purchase_tds" />
</odoo>
